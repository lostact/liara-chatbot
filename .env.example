# ==========================================
# Liara Docs Chatbot Environment Configuration
# ==========================================

# Environment Mode
ENV=development
LOG_LEVEL=INFO

# PostgreSQL Configuration (with pgvector, pg_trgm, unaccent)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=liara_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/liara_chatbot

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible provider configuration
# LLM_* and EMBEDDING_* may point at the same provider or different providers.
LLM_API_KEY=your-llm-provider-api-key
LLM_BASE_URL=https://ai.liara.ir/api/v1/your-service-id
# Optional proxy reachable from the container. Leave empty for a direct connection.
# HTTP(S): http://host.docker.internal:7890
# SOCKS5:  socks5://host.docker.internal:1080
LLM_PROXY_URL=

# Omit these three values to reuse the LLM provider for embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_PROXY_URL=

# Models
ROUTER_MODEL=openai/gpt-4o-mini
SYNTHESIS_MODEL=openai/gpt-4o-mini
SYNTHESIS_FALLBACK_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_FALLBACK_MODEL=openai/text-embedding-3-small
# The database schema uses vector(1024). Liara's text-embedding-3-large
# supports requesting this size with EMBEDDING_SEND_DIMENSIONS=true.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=true

# Security & Inter-service Tokens
INTERNAL_TOKEN=internal-secret-token-change-in-production
ADMIN_OPERATOR_TOKEN=admin-operator-token-change-in-production
HMAC_SALT=liara-daily-hmac-salt-secure
# JSON list of browser origins allowed to call the chat API.
CORS_ORIGINS=["https://lostact.github.io","https://docs.liara.ir","https://console.liara.ir","https://liara.ir","http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Indexer Configuration
INDEXER_HOST=0.0.0.0
INDEXER_PORT=8001
INDEXER_BASE_URL=http://localhost:8001
DOCS_REPO_URL=https://github.com/liara-cloud/docs.git
DOCS_REPO_BRANCH=master
DOCS_LOCAL_CLONE_DIR=/tmp/liara_docs_repo
